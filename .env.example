# Local stdio MCP (Claude Desktop / Cursor local)
MCP_LOG_LEVEL=info

# ─── Hosted HTTP MCP (deploy to cloud) ───────────────────────────────────────
# Required for mcp/server-http.ts — generate with: openssl rand -hex 32
MCP_API_KEY=change-me-to-a-long-random-secret-min-16-chars

# Server bind (cloud providers set PORT automatically)
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# Comma-separated hostnames for DNS rebinding protection (your deployed domain)
# MCP_ALLOWED_HOSTS=mcp.satvasolutions.com,your-app.onrender.com

# ─── Demo request email (optional) ─────────────────────────────────────────
MCP_SMTP_HOST=smtp.example.com
MCP_SMTP_PORT=587
MCP_SMTP_USER=your-smtp-user
MCP_SMTP_PASS=your-smtp-password
MCP_DEMO_EMAIL_TO=sales@satvasolutions.com
MCP_DEMO_EMAIL_FROM=noreply@satvasolutions.com
