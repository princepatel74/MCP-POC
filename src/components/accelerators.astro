---
import { accelerators } from "@/data/site";
import Link from "@/components/ui/link.astro";
import AiBadge from "@/components/ai/AiBadge.astro";
---

<div class="mt-24">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <AiBadge label="Live Automations" />
    <h2 class="text-4xl font-bold text-brand-900 mt-5">
      Accounting accelerators you can demo today
    </h2>
    <p class="text-lg mt-4 text-slate-600">
      Production-tested AI automations Satva can run on your data today — deploy in days,
      not months.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    {
      accelerators.map((item) => (
        <a
          href={item.href}
          class="cursor-tilt ai-glass ai-glow-border group block p-6 rounded-2xl hover:shadow-lg hover:shadow-violet-500/10 transition duration-300">
          <h3 class="text-xl font-semibold text-brand-900 group-hover:text-brand-700 transition">
            {item.title}
          </h3>
          <p class="text-slate-600 mt-3 text-sm leading-relaxed">
            {item.description}
          </p>
          <span class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-brand-700 group-hover:text-cyan-700">
            See how it works
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="text-center mt-10">
    <Link href="/solutions" style="aura-outline">See all accelerators</Link>
  </div>
</div>
