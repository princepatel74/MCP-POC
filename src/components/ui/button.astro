---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted" | "aura-outline";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const styleMap: Record<string, string> = {
  primary: "btn btn-primary",
  outline: "btn btn-outline",
  "aura-outline": "btn btn-outline-cyan",
  inverted: "btn btn-inverted",
  muted: "btn btn-muted",
};

const sizeMap: Record<string, string> = {
  md: "btn-md",
  lg: "btn-lg",
};
---

<button
  {...rest}
  class:list={[
    styleMap[style] ?? "btn btn-primary",
    sizeMap[size],
    block && "btn-block",
    className,
  ]}
  ><slot />
</button>
