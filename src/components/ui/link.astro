---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted" | "aura" | "aura-outline";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
};

const styles = {
  outline:
    "bg-white border-2 border-brand-800 hover:bg-brand-50 text-brand-900",
  primary:
    "bg-brand-700 text-white hover:bg-brand-800 border-2 border-transparent",
  inverted: "bg-white text-brand-800 border-2 border-transparent",
  muted: "bg-slate-100 hover:bg-slate-200 border-2 border-transparent",
  aura:
    "bg-gradient-to-r from-cyan-500 to-violet-600 text-white hover:from-cyan-400 hover:to-violet-500 border-2 border-transparent shadow-lg shadow-cyan-500/25",
  "aura-outline":
    "bg-transparent border-2 border-cyan-400/40 text-cyan-200 hover:bg-cyan-400/10 hover:border-cyan-400/70",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
