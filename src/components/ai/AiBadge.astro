---
interface Props {
  label?: string;
}

const { label = "AI-Powered" } = Astro.props;
---

<span
  class="inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cyan-700">
  <span class="relative flex h-2 w-2">
    <span
      class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-500 opacity-50"></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-600 animate-node-pulse"></span>
  </span>
  {label}
</span>
