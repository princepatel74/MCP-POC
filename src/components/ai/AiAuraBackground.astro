---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["pointer-events-none absolute inset-0 overflow-hidden", className]} aria-hidden="true">
  <div
    data-cursor-parallax="28"
    class="cursor-parallax absolute -top-32 -left-24 h-[420px] w-[420px] rounded-full bg-cyan-300/30 blur-[100px] animate-aura-drift">
  </div>
  <div
    data-cursor-parallax="20"
    class="cursor-parallax absolute top-1/4 -right-20 h-[360px] w-[360px] rounded-full bg-violet-300/25 blur-[90px] animate-aura-drift"
    style="animation-delay: -4s;">
  </div>
  <div
    data-cursor-parallax="16"
    class="cursor-parallax absolute bottom-0 left-1/3 h-[280px] w-[480px] rounded-full bg-blue-400/15 blur-[80px] animate-aura-pulse">
  </div>

  <svg class="absolute inset-0 h-full w-full opacity-[0.04]" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="ai-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M 48 0 L 0 0 0 48" fill="none" stroke="currentColor" stroke-width="0.5"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#ai-grid)" class="text-brand-600"></rect>
  </svg>
</div>
