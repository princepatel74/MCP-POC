---
import Link from "./ui/link.astro";
---

<div
  class="bg-brand-800 p-10 md:px-16 md:py-16 mt-24 mx-auto max-w-5xl rounded-2xl flex flex-col items-center text-center">
  <h2 class="text-white text-3xl md:text-5xl tracking-tight font-bold">
    Looking for Custom Accounting + ERP Integration?
  </h2>
  <p class="text-brand-100 mt-4 text-lg md:text-xl max-w-2xl">
    Talk to our solutions advisors about integrations, automation, and
    accelerators built for finance teams.
  </p>
  <div class="flex flex-col sm:flex-row gap-3 mt-8">
    <Link href="/contact" style="inverted">Request a Free Consultation</Link>
    <Link href="/case-studies" style="outline" class="!text-white !border-white hover:!bg-brand-700">
      View Case Studies
    </Link>
  </div>
</div>
