---
import Link from "./ui/link.astro";
import AiAuraBackground from "@/components/ai/AiAuraBackground.astro";
---

<div class="relative overflow-hidden p-10 md:px-16 md:py-16 mt-24 mx-auto max-w-5xl rounded-3xl ai-aura-bg ai-glow-border">
  <AiAuraBackground class="opacity-60" />
  <div class="relative z-10 flex flex-col items-center text-center">
    <h2 class="text-white text-3xl md:text-5xl tracking-tight font-bold">
      Ready to automate your accounting stack?
    </h2>
    <p class="text-slate-300 mt-4 text-lg md:text-xl max-w-2xl">
      Talk to our AI integration advisors about ERP connectors, invoice automation,
      and MCP-ready finance workflows.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 mt-8">
      <Link href="/contact" style="aura">Request a Free Consultation</Link>
      <Link href="/case-studies" style="aura-outline">View Case Studies</Link>
    </div>
  </div>
</div>
