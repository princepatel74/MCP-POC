---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
import { hero, company } from "@/data/site";
import AiAuraBackground from "@/components/ai/AiAuraBackground.astro";
import AiBadge from "@/components/ai/AiBadge.astro";
import AccountingDashboard from "@/components/ai/AccountingDashboard.astro";
---

<section class="relative overflow-hidden rounded-3xl ai-aura-bg px-6 py-14 md:px-10 md:py-20 lg:px-14 border border-slate-100">
  <AiAuraBackground />

  <div class="relative z-10 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <div data-cursor-parallax="6">
      <AiBadge label="AI + Accounting Platform" />
      <p class="text-brand-700 font-medium text-sm mt-5 mb-3 tracking-wide">
        {company.tagline}
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight text-brand-900 leading-[1.08]">
        {hero.headline}
        <span class="ai-text-gradient block sm:inline"> {hero.headlineAccent}</span>
      </h1>
      <p class="text-lg mt-6 text-slate-600 max-w-xl leading-relaxed">
        {hero.subtext}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <Link
          href={hero.primaryCta.href}
          style="aura"
          class="flex gap-2 items-center justify-center shadow-lg shadow-cyan-500/15">
          <Icon class="w-5 h-5" name="bx:bx-calendar" />
          {hero.primaryCta.label}
        </Link>
        <Link
          href={hero.secondaryCta.href}
          style="aura-outline"
          class="flex gap-2 items-center justify-center">
          {hero.secondaryCta.label}
        </Link>
      </div>
      <p class="mt-8 text-sm text-slate-500">
        Trusted by {company.clients} · {company.certifications.join(" · ")}
      </p>
    </div>

    <AccountingDashboard />
  </div>
</section>
