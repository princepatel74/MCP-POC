---
import { trustBadges } from "@/data/site";
---

<div class="mt-20 py-12 border-y border-slate-100">
  <p class="text-center text-sm font-medium text-slate-500 uppercase tracking-wider mb-8">
    Brands who trust Satva Solutions
  </p>
  <div class="flex flex-wrap justify-center gap-x-10 gap-y-4">
    {
      trustBadges.map((name) => (
        <span class="text-lg font-semibold text-slate-400">{name}</span>
      ))
    }
  </div>
</div>
