---
import { testimonial } from "@/data/site";
---

<div class="mt-24 relative overflow-hidden rounded-3xl ai-glass ai-glow-border p-10 md:p-16 border border-slate-100">
  <div class="absolute top-0 right-0 w-64 h-64 bg-violet-200/30 blur-[80px] rounded-full pointer-events-none" data-cursor-parallax="14"></div>
  <p class="text-brand-700 text-sm font-semibold uppercase tracking-wider mb-6 relative">
    A client's point of view
  </p>
  <blockquote class="text-xl md:text-2xl leading-relaxed font-light text-slate-700 relative">
    "{testimonial.quote}"
  </blockquote>
  <footer class="mt-8 relative">
    <p class="font-semibold text-brand-900">{testimonial.author}</p>
    <p class="text-slate-500 text-sm mt-1">{testimonial.role}</p>
  </footer>
</div>
