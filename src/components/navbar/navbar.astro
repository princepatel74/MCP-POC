---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { company } from "@/data/site";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Work",
    children: [
      { title: "Case Studies", path: "/case-studies" },
      { title: "Blog", path: "/blog" },
      { title: "FAQs", path: "/faq" },
    ],
  },
  {
    title: "Solutions",
    path: "/solutions",
  },
  {
    title: "Services",
    path: "/services",
  },
  {
    title: "Company",
    children: [
      { title: "About Us", path: "/about" },
      { title: "Careers", path: "/about#careers" },
    ],
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<Container>
  <header
    class="flex flex-col lg:flex-row justify-between items-center my-5 border-b border-slate-100 pb-4">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-lg">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-800 text-sm font-bold text-white"
            >S</span
          >
          <span class="font-bold text-brand-900">{company.name}</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-5 h-5 text-brand-900" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-1">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}
                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-slate-600 hover:text-brand-800 font-medium">
                      {item.title}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-4">
          <Link href="/contact" size="md" block>Request a Demo</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div class="hidden lg:flex items-center">
      <Link href="/contact" size="md">Request a Demo</Link>
    </div>
  </header>
</Container>
