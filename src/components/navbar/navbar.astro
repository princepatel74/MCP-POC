---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Logo from "@/components/Logo.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Work",
    children: [
      { title: "Case Studies", path: "/case-studies" },
      { title: "Blog", path: "/blog" },
      { title: "FAQs", path: "/faq" },
    ],
  },
  { title: "Solutions", path: "/solutions" },
  { title: "Services", path: "/services" },
  {
    title: "Company",
    children: [
      { title: "About Us", path: "/about" },
      { title: "Careers", path: "/about#careers" },
    ],
  },
  { title: "Contact", path: "/contact" },
];
---

<Container>
  <header class="sticky top-0 z-50 my-4">
    <div
      class="ai-glass ai-glow-border flex flex-col lg:flex-row justify-between items-center rounded-sm px-4 py-3 lg:px-6">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href="/" class="flex items-center group">
            <Logo height={36} class="group-hover:opacity-90 transition-opacity" />
          </a>
          <div class="block lg:hidden">
            <MenuIcon class="w-5 h-5 text-brand-900" />
          </div>
        </div>
        <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
          <ul class="flex flex-col lg:flex-row lg:gap-1">
            {
              menuitems.map((item, index) => (
                <>
                  {item.children && (
                    <Dropdown
                      title={item.title}
                      children={item.children}
                      lastItem={index === menuitems.length - 1}
                    />
                  )}
                  {!item.children && (
                    <li>
                      <a
                        href={item.path}
                        class="flex lg:px-3 py-2 items-center text-satva-gray-dark hover:text-brand-600 font-medium transition">
                        {item.title}
                      </a>
                    </li>
                  )}
                </>
              ))
            }
          </ul>
          <div class="lg:hidden flex items-center mt-4">
            <Link href="/contact" size="md" style="primary" block>Request a Demo</Link>
          </div>
        </MenuItems>
      </Astronav>
      <div class="hidden lg:flex items-center gap-4">
        <span class="hidden xl:inline-flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-widest text-brand-600">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          MCP-enabled
        </span>
        <Link href="/contact" size="md" style="primary">Request a Demo</Link>
      </div>
    </div>
  </header>
</Container>
