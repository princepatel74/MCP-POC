---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Cta from "@/components/cta.astro";
import { company } from "@/data/site";

const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="About Us" description={`Learn about ${company.name} — ${company.experience} of accounting and ERP integration expertise.`}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">About {company.name}</Fragment>
      <Fragment slot="desc">
        Deep finance domain expertise paired with engineering excellence.
      </Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-6 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-brand-900">
        Accounting & Finance, Engineered.
      </h2>
      <p class="text-lg leading-relaxed text-slate-600">
        {company.name} is uniquely qualified with {company.experience} of
        experience working with custom accounting software, ERP integration,
        API integrations, and fintech app development. We help businesses and SaaS
        platforms automate financial workflows, connect disparate systems, and
        build products finance teams actually need.
      </p>
      <p class="text-lg leading-relaxed text-slate-600">
        Trusted by {company.clients}. Certified on {company.certifications.join(", ")}.
      </p>

      <div class="grid sm:grid-cols-3 gap-6 mt-8">
        <div class="p-6 rounded-xl bg-brand-50 text-center">
          <div class="text-3xl font-bold text-brand-800">15+</div>
          <p class="text-sm text-slate-600 mt-1">Years Experience</p>
        </div>
        <div class="p-6 rounded-xl bg-brand-50 text-center">
          <div class="text-3xl font-bold text-brand-800">50+</div>
          <p class="text-sm text-slate-600 mt-1">Integrations Built</p>
        </div>
        <div class="p-6 rounded-xl bg-brand-50 text-center">
          <div class="text-3xl font-bold text-brand-800">6</div>
          <p class="text-sm text-slate-600 mt-1">Countries Served</p>
        </div>
      </div>
    </div>

    <div class="mt-20" id="careers">
      <h2 class="text-2xl font-bold text-brand-900 text-center mb-4">
        Looking for the best workplace experience?
      </h2>
      <p class="text-center text-slate-600 max-w-2xl mx-auto">
        Join our team of finance-domain engineers, integration specialists, and
        product builders. We're always looking for talented people who understand
        both code and accounting.
      </p>
      <p class="text-center mt-6">
        <a href="/contact" class="text-brand-700 font-semibold hover:text-brand-900">
          Join our team →
        </a>
      </p>
    </div>

    <Cta />
  </Container>
</Layout>
