---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Cta from "@/components/cta.astro";
import { caseStudies } from "@/data/case-studies";
---

<Layout
  title="Case Studies"
  description="See how Satva Solutions helped businesses reduce manual work, integrate accounting systems, and automate finance operations.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Case Studies</Fragment>
      <Fragment slot="desc">
        Real results from accounting integrations, ERP connections, and finance
        automation projects across industries.
      </Fragment>
    </Sectionhead>

    <div class="grid gap-12 mt-16 max-w-5xl mx-auto">
      {
        caseStudies.map((study) => (
          <article class="grid md:grid-cols-5 gap-8 items-start pb-12 border-b border-slate-100 last:border-0">
            <div class="md:col-span-2 aspect-video rounded-xl overflow-hidden bg-slate-100">
              <img
                src={study.image}
                alt={study.client}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="md:col-span-3">
              <div class="flex items-baseline gap-3 mb-2">
                <span class="text-4xl font-bold text-brand-700">{study.metric}</span>
                <span class="text-slate-500">{study.metricLabel}</span>
              </div>
              <p class="text-sm font-medium text-brand-600 uppercase tracking-wide">
                {study.client}
              </p>
              <h2 class="text-2xl font-bold text-brand-900 mt-2 leading-snug">
                {study.title}
              </h2>
              <p class="text-slate-600 mt-4 leading-relaxed">{study.summary}</p>
              <div class="flex flex-wrap gap-2 mt-5">
                {study.tags.map((tag) => (
                  <span class="text-xs bg-brand-50 text-brand-700 px-3 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <Cta />
  </Container>
</Layout>
